# Скопируйте этот файл в .env.

# Точная транскрибация и ИИ-разбор. Можно оставить пустым для деморежима Chrome.
AI_API_KEY=
# Совместимость: можно указать OPENAI_API_KEY вместо AI_API_KEY
OPENAI_API_KEY=

# Провайдер: auto | tuzi | chatanywhere | proxyapi | aitunnel | deepseek | openai | custom
# auto — сервер сам подберёт рабочий endpoint по ключу
AI_PROVIDER=auto

# 兔子API TuZi (https://api.tu-zi.com) — ключи часто начинаются с sk-hi:
# AI_PROVIDER=tuzi
# AI_BASE_URL=https://api.tu-zi.com/v1
# ANALYSIS_MODEL=gpt-4o-mini
# TRANSCRIBE_MODEL=whisper-1

# ChatAnywhere:
# AI_PROVIDER=chatanywhere
# AI_BASE_URL=https://api.chatanywhere.tech/v1
# ANALYSIS_MODEL=gpt-4o-mini
# TRANSCRIBE_MODEL=whisper-1

# Свой endpoint (если ключ от другого прокси). Пример ProxyAPI:
# AI_BASE_URL=https://openai.api.proxyapi.ru/v1
# AI_BASE_URL=https://api.aitunnel.ru/v1

# Модели (для proxyapi рекомендуем Gemini — сильный разбор русской речи):
# ANALYSIS_MODEL=google/gemini-2.5-pro
# TRANSCRIBE_MODEL=openai/whisper-1
ANALYSIS_MODEL=
TRANSCRIBE_MODEL=

# Первый администратор создаётся автоматически при первом запуске.
# ОБЯЗАТЕЛЬНО поменяйте пароль перед публикацией сайта в интернете.
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@minute.local
ADMIN_PASSWORD=Admin123!

# Рейтинг показывает только реально зарегистрированных учеников.
SEED_DEMO_DATA=false

PORT=3000
HOST=0.0.0.0

# Локально false, на Render/production — true (или оставьте пустым для автоопределения).
COOKIE_SECURE=false

# Путь к папке с database.json. На Render с Persistent Disk: /opt/render/project/src/data
# DATA_DIR=

# --- Firebase Firestore (облачная база) ---
# Если заданы credentials ниже, сервер автоматически использует Firestore вместо database.json.
# Явно: DB_BACKEND=firebase или DB_BACKEND=file
# DB_BACKEND=auto

# Вариант 1: путь к скачанному JSON (удобно локально)
# FIREBASE_CREDENTIALS_FILE=C:\Users\user\Downloads\speakup-edd3f-firebase-adminsdk-xxxxx.json

# Вариант 2: весь JSON service account одной строкой (удобно для Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Вариант 2: отдельные поля
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
