{
  "name": "speckup",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Платформа для обучения ораторскому искусству: тренировки, аккаунты, рейтинг, домашние задания и админ-панель.",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
