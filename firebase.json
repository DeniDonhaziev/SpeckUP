{
  "hosting": {
    "site": "speakup-platform",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/health", "function": "api" },
      { "source": "/api/**", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "data",
        ".env",
        "public",
        "START_*.bat",
        "HOW_TO_START.txt",
        "API_SETUP.txt",
        "README.md",
        "render.yaml",
        "firestore.indexes.json"
      ]
    }
  ]
}
