{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "DB_BACKEND": "firebase",
    "COOKIE_SECURE": "true",
    "AI_PROVIDER": "tuzi",
    "AI_BASE_URL": "https://api.tu-zi.com/v1",
    "ANALYSIS_MODEL": "gpt-4o-mini"
  }
}
